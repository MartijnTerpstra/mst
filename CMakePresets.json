{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "dev-base",
            "displayName": "Local dev base",
            "description": "Shared settings for local Debug/Release dev builds (mirrors scripts/build.sh)",
            "hidden": true,
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "MST_RUN_TESTS": true,
                "MST_UTILS": true
            }
        },
        {
            "name": "dev-debug",
            "displayName": "Debug",
            "inherits": "dev-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "dev-release",
            "displayName": "Release",
            "inherits": "dev-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-strict-base",
            "displayName": "Windows strict-warnings base",
            "description": "From CMakeSettings.json's Windows-x64-Dev/Test: /W4 plus SIMD-union/alignment suppressions. NOTE: CMakeLists.txt's own SETUP_TARGET sets /W1 on top of this per-target, which likely wins on the MSVC command line — verify with /showIncludes or a build log if you rely on /W4 actually applying.",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "inherits": "dev-base",
            "binaryDir": "${sourceDir}/build-windows-strict",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /W4 /GR /EHsc /wd4324 /wd4201"
            }
        },
        {
            "name": "windows-strict-debug",
            "displayName": "Windows Debug (strict warnings)",
            "inherits": "windows-strict-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-strict-release",
            "displayName": "Windows Release (strict warnings)",
            "inherits": "windows-strict-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-base",
            "displayName": "Linux base",
            "description": "Shared by the local and VS-remote/WSL Linux configs. condition Linux matches both a native Linux host and a VS remote/WSL target (VS evaluates hostSystemName against the target system there). The vendor exclusionList keeps VS's rsync-based source copy (Tools > Options > Cross Platform > Connection Manager, or a WSL target) from pulling in build output dirs.",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "inherits": "dev-base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-pedantic-errors"
            },
            "vendor": {
                "microsoft.com/VisualStudioRemoteSettings/CMake1": {
                    "copySourcesOptions": {
                        "exclusionList": [
                            ".vs", ".git", ".svn", "out",
                            "_build", "build", "build-linux-gcc", "build-linux-clang", "build-windows-strict"
                        ]
                    }
                }
            }
        },
        {
            "name": "linux-gcc-base",
            "displayName": "Linux GCC base",
            "description": "From CMakeSettings.json's Linux-x64-GCC-Dev/Test",
            "hidden": true,
            "inherits": "linux-base",
            "binaryDir": "${sourceDir}/build-linux-gcc",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc"
            }
        },
        {
            "name": "linux-gcc-debug",
            "displayName": "Linux GCC Debug",
            "inherits": "linux-gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-gcc-release",
            "displayName": "Linux GCC Release",
            "inherits": "linux-gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG"
            }
        },
        {
            "name": "linux-clang-base",
            "displayName": "Linux Clang base",
            "description": "From CMakeSettings.json's Linux-x64-Clang-Dev/Test",
            "hidden": true,
            "inherits": "linux-base",
            "binaryDir": "${sourceDir}/build-linux-clang",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang"
            }
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Linux Clang Debug",
            "inherits": "linux-clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-clang-release",
            "displayName": "Linux Clang Release",
            "inherits": "linux-clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -finline-functions"
            }
        },
        {
            "name": "ci-tests",
            "displayName": "CI unit tests",
            "description": "Matches .github/workflows/UnitTestOnPullRequest.yml (compiler picked up from CC/CXX env). -pedantic-errors is a no-op warning (D9002) under MSVC, so it's safe to set unconditionally here even though this preset also backs the MSVC job.",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "MST_RUN_TESTS": true,
                "CMAKE_CXX_FLAGS": "-pedantic-errors"
            }
        },
        {
            "name": "ci-coverage",
            "displayName": "CI coverage",
            "description": "Matches .github/workflows/Coverage.yml",
            "binaryDir": "${sourceDir}/build",
            "environment": {
                "CXX": "g++",
                "CXXFLAGS": "-O0 -pedantic-errors --coverage -fno-inline -fno-inline-small-functions -fno-default-inline"
            },
            "cacheVariables": {
                "MST_RUN_TESTS": true,
                "MST_TEST_ARGS": "~[not_deterministic]"
            }
        },
        {
            "name": "ci-licenses",
            "displayName": "CI license check",
            "description": "Matches .github/workflows/CheckLicenses.yml",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "MST_UTILS": true
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev-debug",
            "configurePreset": "dev-debug",
            "configuration": "Debug"
        },
        {
            "name": "dev-release",
            "configurePreset": "dev-release",
            "configuration": "Release"
        },
        {
            "name": "windows-strict-debug",
            "configurePreset": "windows-strict-debug",
            "configuration": "Debug"
        },
        {
            "name": "windows-strict-release",
            "configurePreset": "windows-strict-release",
            "configuration": "Release"
        },
        {
            "name": "linux-gcc-debug",
            "configurePreset": "linux-gcc-debug",
            "configuration": "Debug"
        },
        {
            "name": "linux-gcc-release",
            "configurePreset": "linux-gcc-release",
            "configuration": "Release"
        },
        {
            "name": "linux-clang-debug",
            "configurePreset": "linux-clang-debug",
            "configuration": "Debug"
        },
        {
            "name": "linux-clang-release",
            "configurePreset": "linux-clang-release",
            "configuration": "Release"
        },
        {
            "name": "ci-tests",
            "configurePreset": "ci-tests",
            "configuration": "Release"
        },
        {
            "name": "ci-coverage",
            "configurePreset": "ci-coverage",
            "jobs": 10
        },
        {
            "name": "ci-licenses",
            "configurePreset": "ci-licenses",
            "targets": "util_update_licenses"
        }
    ],
    "testPresets": [
        {
            "name": "dev-debug",
            "configurePreset": "dev-debug",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "dev-release",
            "configurePreset": "dev-release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-strict-debug",
            "configurePreset": "windows-strict-debug",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-strict-release",
            "configurePreset": "windows-strict-release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-gcc-debug",
            "configurePreset": "linux-gcc-debug",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-gcc-release",
            "configurePreset": "linux-gcc-release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-clang-debug",
            "configurePreset": "linux-clang-debug",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-clang-release",
            "configurePreset": "linux-clang-release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "ci-tests",
            "configurePreset": "ci-tests",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 10
            }
        },
        {
            "name": "ci-coverage",
            "configurePreset": "ci-coverage",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 4,
                "timeout": 120
            }
        }
    ]
}
